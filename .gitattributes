# 统一换行符处理，避免 Windows 下 CRLF/LF 告警
# 默认：文本文件在仓库内以 LF 存储，检出时按平台自动处理
* text=auto eol=lf

# 明确指定文本类型，仓库内统一 LF
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.vue    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.properties text eol=lf

# Windows 脚本保持 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做换行符转换
*.jar    binary
*.war    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
