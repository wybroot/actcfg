# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=delivery_platform
MYSQL_USER=delivery
MYSQL_PASSWORD=change_me_db

# Redis
REDIS_PASSWORD=change_me_redis

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio

# ── 后端应用配置 ──────────────────────────────────────────────────────────────

# JWT 签名密钥（生产必须改，至少 32 字符的强随机字符串）
# 生成示例：openssl rand -base64 48
APP_JWT_SECRET=change_me_use_at_least_32_chars_here_replace_now

# 敏感配置 AES-256-GCM 加密密钥（base64 编码的 32 字节随机值）
# 生成示例：head -c 32 /dev/urandom | base64
# 不配置则每次重启密钥不同，历史敏感数据无法解密！
APP_ENCRYPTION_KEY_V1=

# 部署包保留天数（超期废弃后可触发清理，默认 90）
APP_PACKAGE_RETENTION_DAYS=90

# ── Harbor 镜像同步（可选）────────────────────────────────────────────────────
# 不填则镜像同步退化为按坐标直接登记（离线/内网场景适用）
HARBOR_BASE_URL=
HARBOR_USERNAME=
HARBOR_PASSWORD=
